{
  "name": "vandana-geetlyrics",
  "version": "1.0.0",
  "description": "A multilingual church songbook (Bengali, Hindi, English) built with Eleventy. Optimized for offline use and fast performance.",
  "main": "index.js",
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy && node scripts/rev-assets.js",
    "build:gh": "BASE_URL=/VandanaGeetlyrics eleventy && BASE_URL=/VandanaGeetlyrics node scripts/rev-assets.js",
    "clean": "rm -rf _site",
    "lint": "eleventy --quiet"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@11ty/eleventy": "^3.1.5"
  },
  "devDependencies": {
    "markdown-it": "^14.1.1"
  }
}