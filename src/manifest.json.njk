  switch to dark-mode accent (#f0a020) because manifest.json is a
  static file. The <meta name="theme-color"> tag in base.njk handles
  runtime switching via JS. This is a PWA platform limitation. #}
  "theme_color": "#e89a1c",
  "dir": "ltr",
  "lang": "en",
  "categories": [
    "music",
    "entertainment"
  ],
  "icons": [
    {
      "src": {{ '/assets/icons/icon-192.png' | url | json | safe }},
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": {{ '/assets/icons/icon-512.png' | url | json | safe }},
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": {{ '/assets/icons/icon-512-maskable.png' | url | json | safe }},
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
