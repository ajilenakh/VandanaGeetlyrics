---
layout: base.njk
title: English Songs
currentLang: english
lang: en
---

<div class="language-page">
  <h1 class="page-title">English Songs</h1>

  <div class="search-box">
    <input
      type="search"
      id="song-search"
      class="search-input"
      placeholder="Search by number or title..."
      aria-label="Search songs"
    />
  </div>

  <div class="song-grid" id="song-grid">
    {% for song in collections.english %}
      <a href="{{ ('/english/' + song.fileSlug + '/') | url }}" class="song-card" data-number="{{ song.data.number }}" data-title="{{ song.data.title | lower | escape }}">
        <div class="song-card-content">
          <span class="song-card-number">{{ song.data.number }}</span>
          <h2 class="song-card-title">{{ song.data.title | escape }}</h2>
          <svg class="song-card-arrow" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </div>
      </a>
    {% endfor %}
  </div>

  <div id="no-results" class="no-results" style="display: none;" aria-live="polite">
    <p>We couldn't find that song. Try a different number.</p>
  </div>
</div>

<script src="{{ '/js/search.js' | url }}" defer></script>
