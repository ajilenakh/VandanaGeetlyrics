---
permalink: /songs.json
eleventyExcludeFromCollections: true
---
{%- set allSongs = [] -%}
{%- set languages = [
  {slug: 'bengali', name: 'Bengali'},
  {slug: 'hindi', name: 'Hindi'},
  {slug: 'english', name: 'English'}
] -%}
{%- for lang in languages -%}
  {%- set collection = collections[lang.slug] -%}
  {%- if collection -%}
    {%- for song in collection -%}
      {%- set number = song.data.number -%}
      {%- if number is number and number >= 1 -%}
      {%- set songUrl = ('/' + lang.slug + '/' + number + '/') | url -%}
      {%- set allSongs = allSongs.concat([songUrl]) -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endfor -%}
{{ allSongs | dump | safe }}