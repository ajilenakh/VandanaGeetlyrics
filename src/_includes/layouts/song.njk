---
layout: base.njk
headerType: song
---

{% set bodyClass = 'song-page' %}

<div class="song-detail">
  <div class="song-info">
    <span class="song-number">#{{ number }}</span>
    <h1 class="song-title">{{ title }}</h1>
  </div>

  <div class="song-lyrics">
    {{ content | safe }}
  </div>
</div>
