<header class="header">
  <style>
    #install-btn {
      background: transparent;
      color: var(--text-secondary);
      border: 1px solid var(--border);
      padding: 0.25rem 0.5rem;
      border-radius: 3px;
      font-size: 0.75rem;
      cursor: pointer;
      opacity: 0.7;
      transition: opacity 0.2s, color 0.2s;
      min-height: 32px;
      min-width: 32px;
    }
    #install-btn:hover {
      opacity: 1;
      color: var(--accent);
      border-color: var(--accent);
    }
    #install-btn:focus {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }
    .ios-hint {
      position: fixed;
      bottom: 1rem;
      left: 50%;
      transform: translateX(-50%);
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      padding: 0.75rem 1rem;
      border-radius: 8px;
      font-size: 0.875rem;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      z-index: 1000;
    }
    .ios-hint strong {
      color: var(--accent);
    }
  </style>
  <div class="header-content">
    <div class="header-top">
      <a href="{{ '/' | url }}" class="home-link" aria-label="Home">
        <svg class="home-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 10.5L12 3l9 7.5"></path>
          <path d="M5 10v10h5v-6h4v6h5V10"></path>
        </svg>
      </a>
      <div class="header-controls">
        <button id="theme-toggle" class="control-button" aria-label="Toggle theme">
          <span class="icon-sun" aria-hidden="true">☀️</span>
          <span class="icon-moon" aria-hidden="true">🌙</span>
        </button>
        <button id="install-btn" style="display:none;" aria-label="Add to home screen">Add to Home Screen</button>
        <div id="ios-install-hint" style="display:none;" class="ios-hint">
          <p>To install: tap <strong>Share</strong> → <strong>Add to Home Screen</strong></p>
        </div>
        <button id="font-decrease" class="control-button" aria-label="Decrease font size">
          A-
        </button>
        <button id="font-increase" class="control-button" aria-label="Increase font size">
          A+
        </button>
        <button id="font-reset" class="control-button" aria-label="Reset font size">
          Reset
        </button>
      </div>
    </div>
    <nav class="language-switcher" aria-label="Language navigation">
      <a href="{{ '/bengali/' | url }}" class="lang-link" {% if currentLang == "bengali" %}aria-current="page"{% endif %}>বাংলা</a>
      <a href="{{ '/hindi/' | url }}" class="lang-link" {% if currentLang == "hindi" %}aria-current="page"{% endif %}>हिंदी</a>
      <a href="{{ '/english/' | url }}" class="lang-link" {% if currentLang == "english" %}aria-current="page"{% endif %}>English</a>
    </nav>
  </div>
</header>
