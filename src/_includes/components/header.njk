<header class="header">
  <div class="header-content">
    <div class="header-left">
      <a href="/" class="home-link">Home</a>
    </div>
    <div class="header-controls">
      <button id="theme-toggle" class="control-button" aria-label="Toggle dark mode">
        🌙
      </button>
      <button id="font-decrease" class="control-button" aria-label="Decrease font size">
        A-
      </button>
      <button id="font-increase" class="control-button" aria-label="Increase font size">
        A+
      </button>
      <button id="font-reset" class="control-button" aria-label="Reset font size">
        Reset
      </button>
    </div>
  </div>
</header>
